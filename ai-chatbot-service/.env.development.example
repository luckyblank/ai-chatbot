# Development environment only. Copy to .env.development in this directory;
# application-dev.yml imports that ignored file when running from this module.
# Do not put real credentials in version control.
AI_ENABLED=false
AI_DASHSCOPE_API_KEY=
AI_CALL_TIMEOUT_SECONDS=45
AI_TOOL_CALL_TIMEOUT_SECONDS=120
# Optional: use a maintained product knowledge base instead of the built-in product manual.
# WIDGET_KNOWLEDGE_BASE_ID=knowledge-base-id-from-the-knowledge-center

SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/ai_chatbot?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=replace-with-local-database-password
APP_STORAGE_ROOT=./runtime-data
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_UPLOAD_MAX_SIZE=104857600
