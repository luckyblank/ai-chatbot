# Copy to .env for a local deployment. The real .env file is ignored by Git.
# Replace every value below; do not commit real passwords or model keys.
SERVICE_DB_NAME=ai_chatbot
SERVICE_DB_USERNAME=ai_chatbot
SERVICE_DB_PASSWORD=replace-with-a-random-database-password
SERVICE_DB_ROOT_PASSWORD=replace-with-a-different-random-root-password
SERVICE_ADMIN_USERNAME=admin
# Existing databases keep the stored admin password hash; changing this only seeds a missing account.
SERVICE_ADMIN_PASSWORD=replace-with-a-random-admin-password
SERVICE_ADMIN_DISPLAY_NAME=系统管理员

# Keep all published ports local for this single-machine deployment.
SERVICE_BIND_ADDRESS=127.0.0.1
# Set true only when the browser reaches the app through HTTPS.
SERVICE_COOKIE_SECURE=false

# Keep the seeded offline workflow example available without a model key.
AI_ENABLED=false
# AI_DASHSCOPE_API_KEY=replace-only-when-ai-enabled

SERVICE_WEB_PORT=15175
SERVICE_BACKEND_PORT=18082
SERVICE_MYSQL_PORT=13318

# To attach existing named data volumes, set both volume names and switch this to true.
# Existing MySQL data ignores the password variables above; use its actual credentials.
SERVICE_EXISTING_VOLUMES=false
# SERVICE_MYSQL_VOLUME=existing-mysql-volume-name
# SERVICE_RUNTIME_VOLUME=existing-runtime-volume-name
