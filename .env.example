# Copy to .env for a local demo. The real .env file is ignored by Git.
# Replace every value below; do not commit real passwords or model keys.
DEMO_DB_NAME=ai_chatbot_demo
DEMO_DB_USERNAME=ai_chatbot
DEMO_DB_PASSWORD=replace-with-a-random-database-password
DEMO_DB_ROOT_PASSWORD=replace-with-a-different-random-root-password
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=replace-with-a-random-admin-password
DEMO_ADMIN_DISPLAY_NAME=演示管理员

# Keep all published ports local for the single-machine demo.
DEMO_BIND_ADDRESS=127.0.0.1
# Set true only when the browser reaches the app through HTTPS.
DEMO_COOKIE_SECURE=false

# Keep the deterministic offline workflow demo available without a model key.
AI_ENABLED=false
# AI_DASHSCOPE_API_KEY=replace-only-when-ai-enabled

DEMO_WEB_PORT=15173
DEMO_BACKEND_PORT=18080
DEMO_MYSQL_PORT=13316
